---
/**
 * The seven Mercados pages.
 *
 * Built to the design philosophy the US site uses for Markets We Serve
 * (~/GitHub/IFS-Coatings, content/markets/*.md rendered through
 * src/components/blocks/): a page is a sequence of full-bleed sections on
 * alternating surfaces, each opening with a red eyebrow over a heavy display
 * heading, ending on a red CTA band. No sidebar, no article panel, lists
 * rendered as separator grids rather than bullets.
 *
 *   photo hero → breadcrumb + overview panel → one band per section
 *   → other markets → CTA
 *
 * The old pages were a bare photo band carrying no title, then 140-750 words of
 * unbroken prose beside a floating sidebar with no images in the body at all.
 * All copy still comes from that extracted page — the extractor groups the flat
 * run into these sections and checks, character for character, that grouping
 * moved every word and dropped none. Only the photography is new.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import MarketHero from "@/components/market/MarketHero.astro";
import MarketOverview from "@/components/market/MarketOverview.astro";
import MarketSection from "@/components/market/MarketSection.astro";
import MarketNav from "@/components/market/MarketNav.astro";
import cta from "@/content/market-cta.json";
import type { Market } from "@/lib/blocks";

interface Props {
  market: Market;
  description?: string;
}

const { market, description = "" } = Astro.props;
const { key, title, heroImage, supportImage, lead, sections, sidebar } = market;

// "Mercados" is the old site's own word for the category: it is the heading of
// the sidebar these pages carried. The home page presents the seven markets, so
// that is where the category crumb points.
const category = sidebar?.heading || "Mercados";
const categoryHref = "/#mercados";
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <MarketHero
    title={title}
    eyebrow={category}
    lead={lead.hero}
    image={heroImage}
    action={{ label: cta.label, href: cta.href }}
  />

  <MarketOverview
    title={title}
    category={category}
    categoryHref={categoryHref}
    headline={lead.headline}
    body={lead.body}
    image={supportImage}
  />

  {
    sections.map((section, i) => (
      <MarketSection section={section} eyebrow={title} alt={i % 2 === 1} />
    ))
  }

  {sidebar && <MarketNav heading={category} items={sidebar.items} />}

  <CtaBanner market={key} />
</BaseLayout>
