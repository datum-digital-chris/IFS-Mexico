---
/**
 * Colores.
 *
 * The old page split its 190 RAL swatches across three tabs labelled "RAL
 * Colors 1", "2" and "3" — a division with no meaning, made where the first
 * panel got long, and one that hid two thirds of the range behind a control
 * that showed no selected state. Nothing could be found: a visitor looking for
 * a green had to open all three tabs.
 *
 * They are presented here the way the US site presents the same content
 * (~/GitHub/IFS-Coatings, src/components/RalColorSearch.tsx): one grid in RAL
 * order, over a search field and a row of colour-family filters. The families
 * are the grouping the range actually has, and each card carries its family's
 * colour on its top edge, so a filtered view and a full one read alike.
 *
 * Every swatch keeps its image, its RAL number and its IFS code, read out of
 * the extracted page by src/lib/colors.ts; `npm run compare` checks the codes
 * survived. The family names are the only authored text on the page.
 *
 * The filter bar is hidden until its script runs. The grid is complete without
 * it — search narrows the page, it is not how the page works.
 */
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/page/PageHero.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import { colorSetOf } from "@/lib/colors";
import cta from "@/content/cta.json";
import type { Doc } from "@/lib/blocks";

const entry = await getEntry("pages", "colors");
if (!entry?.data.doc)
  throw new Error("colors: the extracted page has no doc — run npm run extract");

const doc = entry.data.doc as Doc;
const { groups, notes, total } = colorSetOf(doc.lead.body);

if (!groups.length) {
  console.warn("[colors] no swatches found — the extracted page's shape has changed");
}

// The old page repeated this line above each tab panel. It is the page's only
// sentence, and the header had no standfirst, so it opens the page instead.
const lead = doc.lead.hero || notes[0] || "";

// The header photograph is ifscoatings.com/ral-color/'s — a fan of coated
// chips, which is what this page is a catalogue of. The extracted page's own
// hero is a printed RAL fan deck photographed at an angle, and its text reads
// as a competing set of colour names behind the title.
const heroImage = "/uploads/library/colors-hero.jpg";

// One flat list in RAL order; the family travels with each swatch, for the
// filter and for the card's edge.
const swatches = groups.flatMap((group) => group.swatches.map((swatch) => ({ ...swatch, group })));
---

<BaseLayout title={doc.title} description={lead} ogImage={heroImage}>
  <PageHero
    title={doc.title}
    eyebrow={doc.eyebrow}
    lead={lead}
    image={heroImage}
    action={{ label: cta.label, href: cta.href }}
    secondary={null}
  />

  <section class="bg-surface-alt">
    <div class="container-ox py-5">
      <nav aria-label="Ruta de navegación">
        <ol class="text-ink-body flex flex-wrap items-center gap-2 text-[0.8125rem]">
          <li><a href="/" class="hover:text-brand-hover">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink font-medium">{doc.title}</li>
        </ol>
      </nav>
    </div>

    {
      /* Sticky under the masthead: with 190 swatches the filter has to stay
        within reach of whatever is on screen. */
    }
    <div class="color-filter" hidden data-color-filter>
      <div class="container-ox py-4">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <div class="color-search">
            <svg
              class="color-search__icon"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
                clip-rule="evenodd"></path>
            </svg>
            <label class="sr-only" for="color-search">Buscar por número RAL o código IFS</label>
            <input
              id="color-search"
              type="search"
              autocomplete="off"
              placeholder="Buscar número RAL o código IFS…"
              data-color-query
            />
          </div>
          <p class="text-ink-body text-sm" aria-live="polite">
            <span class="text-ink font-bold tabular-nums" data-color-count>{total}</span> colores
          </p>
        </div>

        <div class="color-ranges mt-3">
          <span class="eyebrow text-ink-muted mr-1 text-[0.6875rem]">Familia de color</span>
          <button type="button" class="color-pill" data-color-range="" aria-pressed="true"
            >Todos</button
          >
          {
            groups.map((group) => (
              <button
                type="button"
                class="color-pill"
                data-color-range={group.key}
                aria-pressed="false"
                style={`--group-color:${group.hex}`}
              >
                <span class="color-pill__chip" aria-hidden="true" />
                {group.label}
                <span class="color-pill__count">{group.swatches.length}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="container-ox pt-10 pb-[var(--spacing-band)] sm:pb-[var(--spacing-band-lg)]">
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {
          swatches.map((swatch) => (
            <li
              class="swatch"
              id={swatch.name.toLowerCase().replace(/\s+/g, "-")}
              style={`--group-color:${swatch.group.hex}`}
              data-color-group={swatch.group.key}
              data-color-terms={`${swatch.name} ${swatch.code} ${swatch.group.label}`.toLowerCase()}
            >
              {swatch.image && (
                <img
                  src={swatch.image}
                  alt=""
                  width="600"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="swatch__chip"
                />
              )}
              <div class="swatch__meta">
                <p class="swatch__name">{swatch.name}</p>
                <p class="swatch__code">{swatch.code}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="text-ink-muted py-16 text-center text-lg" hidden data-color-empty>
        Ningún color coincide con esa búsqueda.
      </p>
    </div>
  </section>

  <CtaBanner page={doc.key} />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>("[data-color-filter]");
  const input = document.querySelector<HTMLInputElement>("[data-color-query]");
  const count = document.querySelector<HTMLElement>("[data-color-count]");
  const empty = document.querySelector<HTMLElement>("[data-color-empty]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-color-terms]"));
  const ranges = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-color-range]"));

  if (bar && input && count && cards.length) {
    let range = "";

    const apply = () => {
      // RAL numbers are read out as "1000" or "ral 1000" and codes with or
      // without their prefix, so the query is matched as a bare substring.
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const hit =
          (!range || card.dataset.colorGroup === range) &&
          (!query || (card.dataset.colorTerms ?? "").includes(query));
        card.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = String(shown);
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener("input", apply);
    for (const button of ranges) {
      button.addEventListener("click", () => {
        range = range === button.dataset.colorRange ? "" : (button.dataset.colorRange ?? "");
        for (const other of ranges) {
          other.setAttribute("aria-pressed", String((other.dataset.colorRange ?? "") === range));
        }
        apply();
      });
    }

    bar.hidden = false;
  }
</script>
