---
/**
 * Calculadora de cobertura.
 *
 * Added at the client's request (October 2026 review) as a metric version of
 * the .com's powder requirement calculator (~/GitHub/IFS-Coatings,
 * src/pages/powder-requirement-calculator.astro). Same method, in the units a
 * Mexican applicator works in: area in m², film in µm, powder in kg.
 *
 * One kilogram of powder of specific gravity SG, laid at a film of t µm,
 * covers 1000 ÷ (SG × t) m² in theory. Transfer efficiency scales that down to
 * what reaches the part. The .com's imperial constant (192.3 ft²/lb at 1 mil)
 * is the same relation in other units, so both calculators give the same
 * answer for the same job.
 *
 * Authored copy, not extracted: npm run compare does not cover it.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/page/PageHero.astro";
import Breadcrumb from "@/components/page/Breadcrumb.astro";
import PageNav from "@/components/page/PageNav.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import cta from "@/content/cta.json";
import { RECURSOS } from "@/data/recursos";
import { sectionNav } from "@/lib/menu";

const page = RECURSOS.calculadora;
const nav = sectionNav("Recursos", page.path);

/** The inputs. `min`/`max` are what the script validates against too. */
const fields = [
  {
    id: "calc-ge",
    label: "Gravedad específica",
    hint: "Viene en la ficha técnica del producto. Rango típico: 1.2 a 1.8.",
    step: "0.01",
    min: "0.01",
    placeholder: "p. ej. 1.5",
  },
  {
    id: "calc-area",
    label: "Área a recubrir (m²)",
    hint: "Superficie total de todas las piezas a recubrir.",
    step: "any",
    min: "0.01",
    placeholder: "p. ej. 500",
  },
  {
    id: "calc-um",
    label: "Espesor de película (µm)",
    hint: "Recubrimiento en polvo típico: 50 a 100 µm.",
    step: "1",
    min: "1",
    value: "60",
  },
  {
    id: "calc-et",
    label: "Eficiencia de transferencia (%)",
    hint: "Pistola electrostática: 60 a 75 %. Lecho fluidizado: 95 % o más.",
    step: "1",
    min: "1",
    max: "100",
    value: "65",
  },
  {
    id: "calc-margen",
    label: "Margen de seguridad (%)",
    hint: "Para arranques, cambios de color y geometrías complejas. Normalmente de 10 a 15 %.",
    step: "5",
    min: "0",
    max: "100",
    value: "15",
  },
];

const steps = [
  {
    index: "01",
    headline: "Cobertura teórica",
    body: "Un kilogramo de polvo cubre un área máxima que depende de su gravedad específica y del espesor de película. Un polvo más denso cubre menos área por kilogramo.",
    formula: "1000 ÷ (GE × µm) = m²/kg",
  },
  {
    index: "02",
    headline: "Eficiencia de transferencia",
    body: "No todo el polvo aplicado llega a la pieza. La eficiencia de transferencia descuenta el sobrerrociado; una línea electrostática bien ajustada trabaja normalmente entre 60 y 75 %.",
    formula: "Cobertura teórica × ET % = m²/kg efectivos",
  },
  {
    index: "03",
    headline: "Polvo requerido",
    body: "Divida el área total entre la cobertura efectiva. Agregue un margen de seguridad, normalmente de 10 a 15 %, para arranques, cambios de color y geometrías complejas.",
    formula: "(Área × Capas) ÷ m²/kg efectivos = kg",
  },
];

const stat = "text-surface/70 font-heading text-xs font-bold tracking-[0.15em] uppercase";
---

<BaseLayout title={page.title} description={page.description} ogImage={page.hero}>
  <PageHero
    title={page.title}
    eyebrow="Recursos"
    lead={`${page.description} El resultado se actualiza al escribir.`}
    image={page.hero}
    action={{ label: "Ir a la calculadora", href: "#calculadora" }}
    secondary={{ label: "Solicitar una cotización", href: cta.href }}
  />

  <section id="calculadora" class="bg-surface-alt">
    <div class="container-ox band--tight">
      <Breadcrumb title={page.title} category="Recursos" categoryHref={null} class="mb-10" />
      <div class="mb-14">
        <p class="eyebrow mb-4">Calculadora</p>
        <h2 class="display display--black text-ink text-3xl sm:text-4xl">
          ¿Cuánto polvo necesita?
        </h2>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <form class="border-surface-edge bg-surface border p-6 sm:p-8" data-calculator novalidate>
          <div class="space-y-6">
            {
              fields.map((f) => (
                <div>
                  <label class="ox-label" for={f.id}>
                    {f.label}
                  </label>
                  <input
                    class="ox-field"
                    type="number"
                    id={f.id}
                    inputmode="decimal"
                    step={f.step}
                    min={f.min}
                    max={f.max}
                    value={f.value}
                    placeholder={f.placeholder}
                    aria-describedby={`${f.id}-hint`}
                  />
                  <p class="ox-hint" id={`${f.id}-hint`}>
                    {f.hint}
                  </p>
                </div>
              ))
            }

            <div>
              <label class="ox-label" for="calc-capas">Número de capas</label>
              <select class="ox-field" id="calc-capas">
                <option value="1">1 capa</option>
                <option value="2">2 capas</option>
                <option value="3">3 capas</option>
              </select>
            </div>

            <button type="reset" class="ox-link">Restablecer</button>
          </div>
        </form>

        <div class="bg-surface-dark text-surface flex flex-col p-6 sm:p-8">
          <p class="text-surface/70 my-auto py-12 text-center" data-placeholder>
            Complete los campos para calcular el polvo que necesita.
          </p>
          <p
            class="text-surface my-auto py-12 text-center font-semibold"
            role="alert"
            data-error
            hidden
          >
          </p>

          <div hidden data-result>
            <p class={stat}>Polvo requerido</p>
            <p class="mt-2 flex items-baseline gap-2.5">
              <span class="font-heading text-6xl leading-none font-black tabular-nums" data-out="kg"
              ></span>
              <span class="text-xl font-semibold">kg</span>
            </p>
            <p class="text-surface/70 mt-2 text-sm" data-out="summary"></p>

            <div class="border-surface/20 mt-8 border-t pt-6">
              <p class={stat}>Cantidad recomendada a pedir</p>
              <p class="mt-2 flex items-baseline gap-2.5">
                <span
                  class="font-heading text-4xl leading-none font-black tabular-nums"
                  data-out="order"></span>
                <span class="text-xl font-semibold">kg</span>
              </p>
              <p class="text-surface/70 mt-2 text-sm" data-out="margin"></p>
            </div>

            <dl class="border-surface/20 mt-8 grid grid-cols-2 gap-6 border-t pt-6">
              <div>
                <dt class={stat}>Consumo</dt>
                <dd class="mt-2 text-2xl font-bold tabular-nums">
                  <span data-out="kgm2"></span>
                  <span class="text-base font-semibold">kg/m²</span>
                </dd>
              </div>
              <div>
                <dt class={stat}>Rendimiento efectivo</dt>
                <dd class="mt-2 text-2xl font-bold tabular-nums">
                  <span data-out="m2kg"></span>
                  <span class="text-base font-semibold">m²/kg</span>
                </dd>
              </div>
            </dl>
          </div>

          {/* One short line for screen readers, not the whole panel. */}
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-announce></p>

          <a href={cta.href} class="ox-btn ox-btn--white mt-8 self-start"
            >Solicitar una cotización</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-warm">
    <div class="container-ox band--tight">
      <div class="mb-14">
        <p class="eyebrow mb-4">El cálculo</p>
        <h2 class="display display--black text-ink text-3xl sm:text-4xl">
          Cómo funciona la fórmula
        </h2>
        <p class="text-ink-body mt-4 max-w-xl text-lg">
          Tres pasos de la gravedad específica a la cantidad a pedir.
        </p>
      </div>

      <ol class="grid gap-6 md:grid-cols-3">
        {
          steps.map(({ index, headline, body, formula }) => (
            <li class="bg-surface border-t-brand flex flex-col border-t-4 p-6 sm:p-8">
              <span class="text-accent-text font-heading font-black tracking-[0.15em] tabular-nums">
                {index}
              </span>
              <h3 class="display display--black text-ink mt-4 text-2xl">{headline}</h3>
              <p class="text-ink-body mt-3 flex-1">{body}</p>
              <p class="border-surface-edge text-ink mt-6 border-t pt-4 font-mono text-sm font-semibold">
                {formula}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="bg-surface mt-6 p-6 sm:p-8">
        <p class="text-ink-muted font-heading text-xs font-bold tracking-widest uppercase">
          Expresión completa
        </p>
        <p class="text-ink mt-3 font-mono font-medium">
          kg = (Área × Capas × GE × µm) ÷ (1000 × ET %)
        </p>
      </div>
    </div>
  </section>

  <PageNav heading={nav.heading} items={nav.items} />
  <CtaBanner page="calculadora-de-cobertura" />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-calculator]");
  const placeholder = document.querySelector<HTMLElement>("[data-placeholder]");
  const error = document.querySelector<HTMLElement>("[data-error]");
  const result = document.querySelector<HTMLElement>("[data-result]");
  const announce = document.querySelector<HTMLElement>("[data-announce]");

  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const out = (key: string, text: string) => {
    const el = document.querySelector(`[data-out="${key}"]`);
    if (el) el.textContent = text;
  };
  const fmt = (n: number, digits: number) =>
    n.toLocaleString("es-MX", { minimumFractionDigits: digits, maximumFractionDigits: digits });

  /** Value of a required field: null while empty, NaN when out of range. */
  function read(id: string, name: string, problems: string[]): number | null {
    const el = input(id);
    if (el.value.trim() === "") {
      el.removeAttribute("aria-invalid");
      return null;
    }
    const value = Number.parseFloat(el.value);
    const min = Number.parseFloat(el.min);
    const max = el.max ? Number.parseFloat(el.max) : Infinity;
    const ok = Number.isFinite(value) && value >= min && value <= max;
    el.toggleAttribute("aria-invalid", !ok);
    if (ok) return value;
    problems.push(
      Number.isFinite(max)
        ? `${name} debe estar entre ${min} y ${max}.`
        : `${name} debe ser mayor que 0.`,
    );
    return Number.NaN;
  }

  let announceTimer: ReturnType<typeof setTimeout> | undefined;

  function show(state: "placeholder" | "error" | "result") {
    if (placeholder) placeholder.hidden = state !== "placeholder";
    if (error) error.hidden = state !== "error";
    if (result) result.hidden = state !== "result";
  }

  function calculate() {
    const problems: string[] = [];
    const ge = read("calc-ge", "La gravedad específica", problems);
    const area = read("calc-area", "El área", problems);
    const um = read("calc-um", "El espesor de película", problems);
    const et = read("calc-et", "La eficiencia de transferencia", problems);
    const margin = read("calc-margen", "El margen de seguridad", problems) ?? 0;
    const coats = Number.parseInt(input("calc-capas").value, 10) || 1;

    clearTimeout(announceTimer);
    if (problems.length) {
      if (error) error.textContent = problems.join(" ");
      show("error");
      return;
    }
    if (ge === null || area === null || um === null || et === null) {
      show("placeholder");
      if (announce) announce.textContent = "";
      return;
    }

    // Effective coverage: m² one kilogram actually coats, after overspray.
    const m2PerKg = (1000 / (ge * um)) * (et / 100);
    const kg = (area * coats) / m2PerKg;
    const order = kg * (1 + margin / 100);

    out("kg", fmt(kg, 2));
    out("order", fmt(order, 1));
    out("margin", `Incluye ${fmt(margin, 0)} % de margen (+ ${fmt(order - kg, 2)} kg)`);
    out("kgm2", fmt(kg / area, 3));
    out("m2kg", fmt(m2PerKg, 2));
    const capas = coats > 1 ? ` · ${coats} capas` : "";
    out("summary", `${fmt(area, 0)} m² · ${fmt(um, 0)} µm · ${fmt(et, 0)} % ET${capas}`);
    show("result");

    // Announced once typing pauses, rather than on every keystroke.
    announceTimer = setTimeout(() => {
      if (announce) {
        announce.textContent = `Polvo requerido: ${fmt(kg, 2)} kg. Cantidad recomendada: ${fmt(order, 1)} kg.`;
      }
    }, 800);
  }

  form?.addEventListener("input", calculate);
  // Reset restores the defaults only after the event, so recalculate next tick.
  form?.addEventListener("reset", () => setTimeout(calculate));
  // Back navigation and autofill restore values without an input event.
  window.addEventListener("pageshow", calculate);
  calculate();
</script>
