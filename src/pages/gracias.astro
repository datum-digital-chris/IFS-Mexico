---
/**
 * Confirmation page for the contact form. Kept out of the sitemap and search
 * results: it is meaningless arrived at cold.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Gracias">
  <meta slot="head" name="robots" content="noindex, follow" />
  <section class="bg-surface-warm">
    <div class="container-ox band">
      <h1 class="display display--black max-w-measure text-4xl sm:text-5xl">
        Gracias por comunicarse con nosotros
      </h1>
      <p class="text-lead text-ink-muted mt-4">
        Hemos recibido su mensaje y le responderemos a la brevedad.
      </p>
      <a
        href="/"
        class="rounded-button border-surface-sunken bg-surface-sunken text-ink-muted hover:bg-surface-dark hover:text-surface mt-6 inline-block border px-5 py-2 font-medium transition-all"
        >Volver al inicio</a
      >
    </div>
  </section>
</BaseLayout>
