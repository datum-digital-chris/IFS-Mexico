---
/**
 * E-book: the guide to applying powder coatings, in Spanish.
 *
 * Added at the client's request (October 2026 review). The .com links its
 * English edition directly; here the download asks for an email first, which
 * is what the client asked for. The form is a Netlify Form like the contact
 * form, and the confirmation page carries the download (src/data/ebook.json).
 *
 * The email is collected to send the guide. Anything further from IFS is a
 * separate purpose, so it is a separate, unticked box (LFPDPPP lets the person
 * refuse secondary purposes); a submission records which they chose.
 *
 * The gate is a courtesy, not access control: the PDF is a static file and its
 * address is not secret. It is kept out of search results by an X-Robots-Tag
 * header in netlify.toml.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/page/PageHero.astro";
import Breadcrumb from "@/components/page/Breadcrumb.astro";
import PageNav from "@/components/page/PageNav.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import AvisoSimplificado from "@/components/AvisoSimplificado.astro";
import ebook from "@/data/ebook.json";
import { RECURSOS } from "@/data/recursos";
import { sectionNav } from "@/lib/menu";

const page = RECURSOS.ebook;
const nav = sectionNav("Recursos", page.path);
---

<BaseLayout title={page.title} description={page.description} ogImage={page.hero}>
  <PageHero
    title={page.title}
    eyebrow="Recursos"
    lead={page.description}
    image={page.hero}
    action={{ label: "Descargar la guía", href: "#descarga" }}
    secondary={null}
  />

  <section id="descarga" class="bg-surface-alt">
    <div class="container-ox band--tight">
      <Breadcrumb title={page.title} category="Recursos" categoryHref={null} class="mb-10" />

      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow mb-4">E-Book</p>
          <h2 class="display display--black text-ink text-3xl sm:text-4xl">{ebook.title}</h2>
          <p class="text-ink-body mt-6 text-lg leading-relaxed">
            Todo lo que necesita para obtener un acabado de calidad con recubrimiento en polvo, de
            la preparación de la superficie al curado, explicado por los técnicos de IFS.
          </p>
        </div>

        <form
          name="ebook"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/guia-de-recubrimiento-en-polvo/descarga/"
          class="border-surface-edge bg-surface border p-6 sm:p-8"
        >
          <input type="hidden" name="form-name" value="ebook" />
          <p class="hidden">
            <label>Si es humano, deje este campo en blanco: <input name="bot-field" /></label>
          </p>

          <div>
            <label class="ox-label" for="ebook-nombre">
              Nombre <span aria-hidden="true">*</span>
            </label>
            <input
              class="ox-field"
              type="text"
              id="ebook-nombre"
              name="nombre"
              required
              autocomplete="name"
            />
          </div>

          <div class="mt-4">
            <label class="ox-label" for="ebook-empresa">Empresa</label>
            <input
              class="ox-field"
              type="text"
              id="ebook-empresa"
              name="empresa"
              autocomplete="organization"
            />
          </div>

          <div class="mt-4">
            <label class="ox-label" for="ebook-email">
              Correo electrónico <span aria-hidden="true">*</span>
            </label>
            <input
              class="ox-field"
              type="email"
              id="ebook-email"
              name="email"
              required
              autocomplete="email"
              aria-describedby="ebook-aviso"
            />
          </div>

          <div class="mt-5 flex items-start gap-3">
            <input
              class="accent-action mt-1 h-4 w-4 shrink-0"
              type="checkbox"
              id="ebook-novedades"
              name="acepta_novedades"
              value="si"
            />
            <label class="text-ink-body text-sm" for="ebook-novedades">
              Deseo recibir ocasionalmente información de productos y novedades de IFS.
            </label>
          </div>

          <AvisoSimplificado
            id="ebook-aviso"
            datos="su nombre, su empresa y su correo electrónico"
            finalidad="enviarle la guía"
            secundaria="enviarle información de productos y novedades de IFS"
            class="mt-4"
          />

          <button type="submit" class="ox-btn mt-6">Descargar la guía</button>
        </form>
      </div>
    </div>
  </section>

  <PageNav heading={nav.heading} items={nav.items} />
  <CtaBanner page="guia-de-recubrimiento-en-polvo" />
</BaseLayout>
