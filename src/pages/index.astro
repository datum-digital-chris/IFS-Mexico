---
/**
 * Home page.
 *
 * The old site rendered the seven markets as seven full-width alternating
 * slabs — about 3,000px to present what is really a seven-item list, with no
 * way to compare the markets against each other. The content is a list, so it
 * is presented as one here.
 *
 * Every string and image comes from `src/content/home.json`, derived from the
 * extracted page by `scripts/extract-content.mjs`. Nothing is added, removed or
 * reworded; `npm run compare` checks that.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import home from "@/content/home.json";

const { hero, intro, markets } = home;
---

<BaseLayout title="Home" description={intro.heading}>
  {
    /* Hero. The three slogans become one headline plus supporting lines, so the
      page opens with a hierarchy rather than a list of three equal claims. */
  }
  <section class="bg-surface-dark relative isolate overflow-hidden">
    {
      hero.image && (
        <img
          src={hero.image}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
          fetchpriority="high"
        />
      )
    }
    {
      /* Scrim. Strong enough behind the copy, then clearing quickly so the
        powder photograph — the best asset the brand has — still reads. The old
        hero flattened it under an even overlay. */
    }
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/45 to-black/5"
      aria-hidden="true"
    >
    </div>

    <div class="container-ox py-24 sm:py-32 lg:py-40">
      <div class="max-w-2xl">
        <h1 class="display display--black text-surface max-w-measure text-5xl sm:text-6xl">
          {hero.headline}
        </h1>
        {
          hero.supporting.length > 0 && (
            <p class="text-surface/85 mt-5 max-w-xl text-[1.125rem] leading-relaxed md:text-[1.25rem]">
              {hero.supporting.join(" · ")}
            </p>
          )
        }
        {
          hero.button && (
            <a href={hero.button.href} class="ox-btn mt-8">
              {hero.button.label}
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    /* Markets. Seven parallel choices, presented so they can be compared.

      The heading was a photo band competing with the hero; it is the heading
      for the markets, so it is the section header block of their band -
      eyebrow, heading, then `mb-14` to the grid, as the style guide has it.
      Two bands for a header and its own content is a split, not a rhythm. */
  }
  <section id="mercados" class="bg-surface-warm band">
    <div class="container-ox">
      <div class="mb-14 text-center">
        <p class="eyebrow mb-4">{intro.eyebrow}</p>
        <h2 class="display ox-rule-center mx-auto max-w-3xl text-3xl text-balance sm:text-4xl">
          {intro.heading}
        </h2>
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          markets.map((m) => (
            <li class="ox-market group bg-surface relative flex flex-col">
              <div class="aspect-[4/3] overflow-hidden">
                {m.image && (
                  <img
                    src={m.image}
                    alt={m.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="display text-xl">
                  {/* Stretched link: the whole card is the target, and the
                      visible "conoce más" stays as the affordance. */}
                  <a
                    href={m.href}
                    class="text-ink group-hover:text-brand-deep after:absolute after:inset-0"
                  >
                    {m.title}
                  </a>
                </h3>
                {m.description && (
                  <p class="mt-2 flex-1 text-[1rem] leading-relaxed">{m.description}</p>
                )}
                <span class="font-heading text-brand-deep mt-5 inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold">
                  {m.label}
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M1 7h11M8 3l4 4-4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
