---
/**
 * Every extracted WordPress page. One generic route and one template: adding a
 * page means adding content, never editing this file.
 */
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Block from "@/components/Block.astro";
import type { Block as BlockType, Doc } from "@/lib/blocks";

export async function getStaticPaths() {
  // Three pages have a template of their own: home (src/pages/index.astro),
  // which presents the seven markets as a grid rather than seven stacked slabs;
  // Contáctenos (src/pages/contactenos.astro), which is a form rather than
  // prose; and Colores (src/pages/colors.astro), which groups the RAL swatches
  // by family instead of splitting them across three meaningless tabs. All
  // three still take every string from the extracted page.
  const OWN_TEMPLATE = new Set(["", "contactenos", "colors"]);
  const pages = (await getCollection("pages")).filter((p) => !OWN_TEMPLATE.has(p.data.slug));
  return pages.map((page) => ({
    params: { slug: page.data.slug || undefined },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, description, ogImage, sections, doc } = page.data;
---

{
  doc ? (
    <PageLayout doc={doc as Doc} description={description} />
  ) : (
    /* A page the extractor could not group. It still renders, as the Oxygen
       tree it came from, rather than disappearing from the site. */
    <BaseLayout title={title} description={description} ogImage={ogImage}>
      {(sections as BlockType[]).map((section) => (
        <Block block={section} />
      ))}
    </BaseLayout>
  )
}
