---
/**
 * One section of a page: an h2 from the old copy and everything under it.
 *
 * Full-bleed, on its own surface, opening with the eyebrow-over-display-heading
 * pattern the US site uses for every section. Adjacent sections alternate
 * surfaces so the page has a rhythm rather than one continuous white field.
 *
 * Where the old copy nested h3s under the h2, those become the numbered items
 * the US site's overview block uses for its advantages: an index, a heavy
 * headline, then the passage, in a hairline-divided grid.
 */
import Block from "@/components/Block.astro";
import { runsOf, type DocSection } from "@/lib/blocks";

interface Props {
  section: DocSection;
  /** Category label above the heading — the page this section belongs to. */
  eyebrow: string;
  /** Alternate the surface against the section before it. */
  alt: boolean;
}

const { section, eyebrow, alt } = Astro.props;
const { id, headline, body, items } = section;

// A spec table or a form is a data grid, not prose: at the 72ch measure its
// columns are cramped. Consecutive prose blocks are grouped so each run gets
// one measured column, and each table sits between them at full section width.
const runs = runsOf(body);
---

<section id={id} class:list={["py-14 md:py-20", alt ? "bg-surface-warm" : "bg-surface"]}>
  <div class="container-ox">
    <div class="mb-9">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2
        class:list={[
          "display max-w-3xl text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]",
          eyebrow && "mt-3.5",
        ]}
      >
        {headline}
      </h2>
    </div>

    {
      runs.map((run) => (
        <div class:list={[run.wide ? "my-8 overflow-x-auto" : "doc-prose"]}>
          {run.blocks.map((b) => (
            <Block block={b} />
          ))}
        </div>
      ))
    }

    {
      items.length > 0 && (
        <div class:list={["doc-items", runs.length > 0 && "mt-12"]}>
          {items.map((item, i) => (
            <div class="p-6 md:p-8">
              <span class="font-heading text-accent-text text-[0.875rem] font-bold tracking-[0.15em] tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="display mt-3 text-[1.3125rem]">{item.headline}</h3>
              <div class="mt-3 text-[1.0625rem]">
                {item.body.map((b) => (
                  <Block block={b} />
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
