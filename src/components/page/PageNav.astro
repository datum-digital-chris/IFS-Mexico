---
/**
 * The rest of the section this page belongs to, as the last band before the CTA.
 *
 * This is the old page's sidebar — "Mercados" on a market page, "Polvos" on a
 * product page. It was a sticky card floating beside the article, which is what
 * forced the whole page into one narrow column; the US site has no sidebar at
 * all and puts its cross-links in a full-bleed band ahead of the CTA. Same
 * links, same labels, same order.
 *
 * The page you are already on is left out — the breadcrumb above says where you
 * are, and a link to the page you are reading is not a link worth having.
 */
interface Props {
  heading: string;
  items: { label: string; href: string | null; current: boolean }[];
}

const { heading, items } = Astro.props;
const others = items.filter((item) => !item.current);
---

{
  others.length > 0 && (
    <section class="bg-surface-dark">
      <div class="container-ox band">
        {heading && <p class="eyebrow eyebrow--on-dark mb-6">{heading}</p>}
        <ul class="doc-nav">
          {others.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-heading text-surface/80 hover:border-action hover:text-surface flex h-full items-center justify-between gap-4 border-l-2 border-transparent px-5 py-4 text-[0.9375rem] font-semibold transition-colors hover:bg-white/5"
              >
                {item.label}
                <svg
                  class="h-3.5 w-3.5 shrink-0"
                  viewBox="0 0 14 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M1 7h11M8 3l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
