---
/**
 * Page header.
 *
 * The US site opens every page on a near-full-height photograph: a brand rule
 * along the top edge, the eyebrow and display title bottom-aligned over a
 * directional scrim, and the action immediately below the standfirst
 * (~/GitHub/IFS-Coatings, src/components/blocks/HeroBlock.astro).
 *
 * That hero also carries a cluster of term/definition spec tiles. There is no
 * counterpart in this copy — these pages have no spec pairs, and filling the
 * column by lifting a bulleted list out of the body would separate the list
 * from the sentence that introduces it. The column is left to the photograph.
 *
 * Eight of the 28 pages have no hero photograph of their own — the legal pages,
 * the downloads list, Conócenos. Those get the same header on the flat dark
 * surface, sized to its copy: a 68vh band of empty navy is not a header, it is
 * a hole.
 */
interface Props {
  title: string;
  eyebrow: string;
  /** Opening paragraph of the page, lifted by the extractor. */
  lead: string;
  image: string | null;
  /** Omitted on the page the action itself points at. */
  action: { label: string; href: string } | null;
  /** The editorial second action, as the reference header carries. */
  secondary: { label: string; href: string } | null;
}

const { title, eyebrow, lead, image, action, secondary } = Astro.props;
---

<section
  class:list={[
    "bg-surface-dark relative isolate flex flex-col justify-end overflow-hidden",
    image && "min-h-[75vh]",
  ]}
>
  {
    image && (
      <img
        src={image}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        fetchpriority="high"
      />
    )
  }
  {
    /* Directional scrim, then a second pass up from the foot: dense enough
      behind the copy, clearing across the frame so the photograph still reads
      on the open side. Neutral black rather than a tinted veil, as on the US
      site - a tint of its own fights the photograph's colour.

      It has to be dense, not subtle: half of these photographs are powder on a
      white ground, and the eyebrow is small red text. */
  }
  {
    image && (
      <Fragment>
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-r from-black/85 via-black/70 to-black/55"
          aria-hidden="true"
        />
        <div
          class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-t from-black/60 to-transparent"
          aria-hidden="true"
        />
      </Fragment>
    )
  }
  {
    /* Mandatory on a photo header, per the style guide: it bridges the white
      masthead into the dark overlay. */
  }
  <div class="bg-brand absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>

  <div class:list={["container-ox", image ? "pt-16 pb-20" : "band"]}>
    {eyebrow && <p class="eyebrow eyebrow--on-dark mb-5">{eyebrow}</p>}
    <h1 class="display display--black text-surface max-w-measure text-5xl sm:text-6xl">
      {title}
    </h1>
    {lead && <p class="text-surface/60 mt-8 max-w-lg text-lg leading-relaxed">{lead}</p>}
    {
      (action || secondary) && (
        <div class="mt-8 flex flex-wrap items-center gap-6">
          {action && (
            <a href={action.href} class="ox-btn ox-btn--lg">
              {action.label}
            </a>
          )}
          {secondary && (
            <a href={secondary.href} class="ox-link ox-link--on-dark">
              {secondary.label}
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</section>
