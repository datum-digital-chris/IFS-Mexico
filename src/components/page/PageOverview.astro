---
/**
 * The breadcrumb, then the page's opening passage.
 *
 * This is the reference page's overview block, measured off
 * https://ifscoatings.com/appliances/ rather than described: a #fafafa band
 * holding a #ebebeb panel with a 1px brand rule across its top, padded to 56px
 * at the widest tier, splitting a display heading and the opening passage
 * against a second column.
 *
 * The panel was removed once, because its padding put the copy 40px in from
 * every other text block and because its width changed with whether the page
 * had a photograph. Both are fixed rather than avoided: the panel is always the
 * full container width, and the inset is the panel's own, the same on every
 * page that has one.
 *
 * There the second column holds authored "advantages"; here it holds the page's
 * photograph, which is the one thing this content has to put beside the copy.
 * A page with neither has no second column, so the panel is capped to the
 * measure plus its own padding rather than run full width with a void in it.
 *
 * A table, the colour tabs or the contact form is not prose and does not belong
 * in a panel, so those run full width below it.
 */
import Block from "@/components/Block.astro";
import { runsOf, type Block as BlockType } from "@/lib/blocks";

interface Props {
  /** Page title, for the current crumb. */
  title: string;
  /** The site's own name for this page's section. */
  category: string;
  categoryHref: string | null;
  /** A page-opening heading, where the copy has one. */
  headline: string | null;
  body: BlockType[];
  image: string | null;
  /** The editorial link the reference block closes its copy column on. */
  action: { label: string; href: string } | null;
}

const { title, category, categoryHref, headline, body, image, action } = Astro.props;

const runs = runsOf(body);
const prose = runs.filter((r) => !r.wide).flatMap((r) => r.blocks);
const wide = runs.filter((r) => r.wide);
const hasLead = prose.length > 0 || headline;
---

<section class="bg-surface-alt">
  <div class="container-ox band">
    <nav aria-label="Ruta de navegación" class:list={[hasLead || wide.length ? "mb-10" : ""]}>
      <ol class="text-ink-body flex flex-wrap items-center gap-2 text-[0.8125rem]">
        <li><a href="/" class="hover:text-brand-hover">Inicio</a></li>
        {
          category && (
            <Fragment>
              <li aria-hidden="true">/</li>
              <li>
                {categoryHref ? (
                  <a href={categoryHref} class="hover:text-brand-hover">
                    {category}
                  </a>
                ) : (
                  category
                )}
              </li>
            </Fragment>
          )
        }
        <li aria-hidden="true">/</li>
        <li class="text-ink font-medium">{title}</li>
      </ol>
    </nav>

    {
      hasLead && (
        <div class:list={["bg-surface-warm", !image && !wide.length && "lg:max-w-[52rem]"]}>
          <div class="bg-brand h-1" aria-hidden="true" />
          <div class="p-8 sm:p-10 lg:p-14">
            <div class:list={["grid gap-10 lg:gap-16", image && "lg:grid-cols-2"]}>
              <div>
                {headline && (
                  <h2 class="display mb-7 text-4xl sm:text-5xl lg:text-6xl">{headline}</h2>
                )}
                <div class="doc-lead">
                  {prose.map((b) => (
                    <Block block={b} />
                  ))}
                </div>
              </div>
              {/* The photograph fills the row beside the copy — unless a grid
                  follows, in which case the copy above it is usually a single
                  introducing line and a stretched photograph would open a hole
                  between that line and the grid it introduces. */}
              {image && (
                <div
                  class:list={[
                    "relative",
                    wide.length
                      ? "h-[280px] self-start lg:h-[340px]"
                      : "min-h-[280px] self-stretch",
                  ]}
                >
                  <img
                    src={image}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              )}
            </div>

            {/* An application grid or a table stays inside the panel, spanning
                both its columns: the sentence that introduces it is in the copy
                column above, and putting the grid on the band below would leave
                that line hanging. */}
            {wide.map((run) => (
              <div class="mt-4 overflow-x-auto">
                {run.blocks.map((b) => (
                  <Block block={b} />
                ))}
              </div>
            ))}

            {action && (
              <a href={action.href} class="ox-link mt-9">
                {action.label}
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            )}
          </div>
        </div>
      )
    }

    {
      !hasLead &&
        wide.map((run) => (
          <div class="overflow-x-auto">
            {run.blocks.map((b) => (
              <Block block={b} />
            ))}
          </div>
        ))
    }
  </div>
</section>
