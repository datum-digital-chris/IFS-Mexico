---
/**
 * The breadcrumb, then the page's opening passage.
 *
 * This was a bordered panel, following the US site's overview block. It has
 * become a section like any other, because the panel was the one thing on the
 * page that could not line up with the rest of it: its padding pushed the copy
 * 40px in from every other text block, and its own width was the container on
 * a page with a support photograph and 52rem on a page without one — the same
 * component at two widths on sibling pages.
 *
 * So: a brand bar, the opening passage at the shared measure, and the
 * photograph beside it filling the rest of the row. Every run of text on the
 * page now starts and ends in the same place.
 *
 * A table, the colour tabs or the contact form is not prose and does not belong
 * at the measure, so those run full width below it.
 */
import Block from "@/components/Block.astro";
import { runsOf, type Block as BlockType } from "@/lib/blocks";

interface Props {
  /** Page title, for the current crumb. */
  title: string;
  /** The site's own name for this page's section. */
  category: string;
  categoryHref: string | null;
  /** A page-opening heading, where the copy has one. */
  headline: string | null;
  body: BlockType[];
  image: string | null;
}

const { title, category, categoryHref, headline, body, image } = Astro.props;

const runs = runsOf(body);
const prose = runs.filter((r) => !r.wide).flatMap((r) => r.blocks);
const wide = runs.filter((r) => r.wide);
const hasLead = prose.length > 0 || headline;
---

<section class="bg-surface-warm">
  <div class="container-ox py-12 md:py-16">
    <nav aria-label="Ruta de navegación" class:list={[hasLead || wide.length ? "mb-9" : ""]}>
      <ol class="text-ink-body flex flex-wrap items-center gap-2 text-[0.8125rem]">
        <li><a href="/" class="hover:text-brand-hover">Inicio</a></li>
        {
          category && (
            <Fragment>
              <li aria-hidden="true">/</li>
              <li>
                {categoryHref ? (
                  <a href={categoryHref} class="hover:text-brand-hover">
                    {category}
                  </a>
                ) : (
                  category
                )}
              </li>
            </Fragment>
          )
        }
        <li aria-hidden="true">/</li>
        <li class="text-ink font-medium">{title}</li>
      </ol>
    </nav>

    {
      hasLead && (
        <div
          class:list={[
            "grid items-start gap-8",
            image && "lg:grid-cols-[minmax(0,var(--container-measure))_minmax(0,1fr)] lg:gap-12",
          ]}
        >
          <div>
            <span class="bg-brand mb-6 block h-[3px] w-14" aria-hidden="true" />
            {headline && (
              <h2 class="display max-w-measure mb-5 text-[clamp(1.75rem,1.4rem+1.2vw,2.375rem)]">
                {headline}
              </h2>
            )}
            <div class="doc-lead">
              {prose.map((b) => (
                <Block block={b} />
              ))}
            </div>
          </div>
          {image && (
            <div class="relative min-h-[280px] self-stretch">
              <img
                src={image}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          )}
        </div>
      )
    }

    {
      wide.map((run) => (
        <div class:list={["overflow-x-auto", hasLead && "mt-12"]}>
          {run.blocks.map((b) => (
            <Block block={b} />
          ))}
        </div>
      ))
    }
  </div>
</section>
