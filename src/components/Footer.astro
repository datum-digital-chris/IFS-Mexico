---
/**
 * Footer, extracted from Oxygen template post 6 and rendered through the same
 * recursive block renderer as page content.
 */
import site from "@/content/site.json";
import Block from "./Block.astro";
import type { Block as BlockType } from "@/lib/blocks";

const footer = site.footer as BlockType | null;
---

<!-- The old footer repeated the masthead's grey gradient. A single solid dark
     surface closes the page instead and gives the last section something to
     contrast against. -->
<footer class="ox-footer bg-surface-dark text-surface">
  {footer && <Block block={footer} />}
</footer>
