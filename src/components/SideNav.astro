---
/**
 * The in-page product navigation Oxygen renders on the powder-type pages.
 *
 * Vertical list on wide screens; below 1121px the original collapsed it behind
 * a hamburger, which is reproduced here with a native <details> so it works
 * without JavaScript.
 */
import type { Block } from "@/lib/blocks";

interface Props {
  block: Block;
}

const { block } = Astro.props;
const items = block.items ?? [];
// The old active state was a flat grey block. A brand left-rule marks position
// without shouting, and every item gets a hairline separator so the list reads
// as one object rather than floating text.
const link =
  "block border-l-2 border-transparent px-4 py-2.5 text-[15px] leading-snug text-ink-body transition-colors hover:border-surface-edge hover:bg-surface-alt hover:text-brand-deep";
const current = "border-action! bg-surface-alt font-medium text-brand-deep";
---

<!-- Sized to content, not stretched: the original collapses to a 40px
     hamburger on narrow screens and is only as wide as its longest item on
     wide ones. -->
<nav id={block.id} class:list={["w-fit", block.className]} aria-label="Tipos de polvo">
  <!-- Wide: the list itself. -->
  <ul class="border-surface-edge bg-surface divide-surface-edge hidden divide-y border xl:block">
    {
      items.map((i) => (
        <li>
          <a
            href={i.href}
            class:list={[link, i.current && current]}
            aria-current={i.current ? "page" : undefined}
          >
            {i.label}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Narrow: the hamburger the original used. -->
  <details class="xl:hidden">
    <summary
      class="my-[10px] flex h-[40px] w-[40px] cursor-pointer list-none flex-col justify-center gap-[4px]"
      aria-label="Abrir menú de polvos"
    >
      <span class="bg-ink block h-[3px] w-[28px]"></span>
      <span class="bg-ink block h-[3px] w-[28px]"></span>
      <span class="bg-ink block h-[3px] w-[28px]"></span>
    </summary>
    <ul class="border-surface-edge bg-surface divide-surface-edge divide-y border">
      {
        items.map((i) => (
          <li>
            <a
              href={i.href}
              class:list={[link, i.current && current]}
              aria-current={i.current ? "page" : undefined}
            >
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>
