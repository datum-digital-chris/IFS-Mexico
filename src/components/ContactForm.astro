---
/**
 * Contact form, rebuilt as a Netlify Form.
 *
 * The old site used Formidable Forms, which needs PHP and cannot survive a
 * static build. Netlify captures submissions from the data-netlify attribute
 * at deploy time; the hidden form-name input is what pairs a submission with
 * this form.
 *
 * The original labels were in English ("Name", "Last", "Subject") on an
 * otherwise entirely Spanish site. They are translated here - see
 * docs/deviations.md, which lists this as a deliberate change.
 */
---

<form
  name="contacto"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/gracias/"
  class="w-full"
>
  <input type="hidden" name="form-name" value="contacto" />
  <p class="hidden">
    <label>Si es humano, deje este campo en blanco: <input name="bot-field" /></label>
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="ox-label" for="nombre">Nombre <span aria-hidden="true">*</span></label>
      <input
        class="ox-field"
        type="text"
        id="nombre"
        name="nombre"
        required
        autocomplete="given-name"
      />
    </div>
    <div>
      <label class="ox-label" for="apellido">Apellido <span aria-hidden="true">*</span></label>
      <input
        class="ox-field"
        type="text"
        id="apellido"
        name="apellido"
        required
        autocomplete="family-name"
      />
    </div>
  </div>

  <div class="mt-4">
    <label class="ox-label" for="email">Correo electrónico <span aria-hidden="true">*</span></label>
    <input class="ox-field" type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="mt-4">
    <label class="ox-label" for="asunto">Asunto <span aria-hidden="true">*</span></label>
    <input class="ox-field" type="text" id="asunto" name="asunto" required />
  </div>

  <div class="mt-4">
    <label class="ox-label" for="mensaje">Mensaje <span aria-hidden="true">*</span></label>
    <textarea class="ox-field" id="mensaje" name="mensaje" rows="6" required></textarea>
  </div>

  <button type="submit" class="ox-btn mt-6"> Enviar </button>
</form>
