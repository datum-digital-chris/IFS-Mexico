---
/**
 * Top bar + masthead, extracted from Oxygen template post 6 so it matches the
 * old site on every page. The nav is a real <nav> with a disclosure-style
 * mobile menu; the old site's version needed JavaScript to open at all, which
 * left it unusable when scripts failed.
 */
import site from "@/content/site.json";

const { topBar, logo, menu } = site;
const here = Astro.url.pathname;
const isCurrent = (href: string | null) => !!href && href !== "/" && here.startsWith(href);
---

<!-- Top bar: a quiet utility strip. Smaller than the old 18px so it reads as
     secondary to the masthead rather than competing with it. -->
<div class="bg-surface-dark text-surface">
  <div class="container-ox flex flex-wrap items-center justify-center gap-x-5 gap-y-0.5 py-1.5 text-[14px] lg:h-[38px] lg:flex-nowrap lg:justify-end lg:gap-x-7 lg:py-0 lg:text-[15px]">
    {topBar.links.map((l) => (
      <a href={l.href} class="text-surface/80 transition-colors hover:text-surface">{l.label}</a>
    ))}
    {/* The flag sits on its own 29px row on mobile, inline with the phone above 992px. */}
    {topBar.flag && <img src={topBar.flag.src} alt={topBar.flag.alt} width="24" height="16" class="h-[18px] w-auto object-contain lg:h-4" />}
    <a href={topBar.phone.href} class="font-medium text-surface transition-colors hover:text-brand">{topBar.phone.label}</a>
  </div>
</div>

<!-- Masthead. The old white-to-grey gradient is the single most dated element
     on the page; a flat surface with one hairline rule replaces it. Sticky, so
     navigation stays reachable on these long product pages. -->
<header class="sticky top-0 z-30 border-b border-surface-edge bg-surface/95 backdrop-blur-sm">
  <div class="container-ox flex h-[84px] items-center justify-between gap-4 xl:h-[88px]">
    {logo && (
      <a href={logo.href} class="shrink-0">
        <img src={logo.src} alt={logo.alt} class="h-[64px] w-[64px] object-contain xl:h-[72px] xl:w-[72px]" width="72" height="72" />
      </a>
    )}

    <nav aria-label="Principal" class="ml-auto">
      <!-- Mobile: a native disclosure, so the menu opens without JavaScript. -->
      <details class="lg:hidden">
        <summary class="cursor-pointer list-none px-3 py-2 text-brand" aria-label="Abrir menú">
          <span class="block h-0.5 w-6 bg-brand"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-brand"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-brand"></span>
        </summary>
        <ul class="absolute left-0 z-20 w-full bg-surface px-5 pb-4 shadow-lg">
          {menu.map((item) => (
            <li class="border-b border-surface-edge py-2">
              <a href={item.href} class="font-medium" aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
              {item.children.length > 0 && (
                <ul class="mt-1 pl-4">
                  {item.children.map((c) => (
                    <li class="py-1">
                      <a href={c.href} class="text-ink" aria-current={isCurrent(c.href) ? "page" : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </details>

      <!-- Desktop: hover/focus dropdowns, CSS only. -->
      <ul class="hidden lg:flex lg:items-center lg:gap-6">
        {menu.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                "relative inline-block py-2 text-[15px] font-heading font-medium tracking-tight text-ink transition-colors hover:text-brand",
                "after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[2px] after:origin-left after:scale-x-0 after:bg-brand after:transition-transform hover:after:scale-x-100",
                isCurrent(item.href) && "text-brand-deep after:scale-x-100",
              ]}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
            {item.children.length > 0 && (
              <ul class="invisible absolute left-0 top-full z-20 min-w-72 border border-surface-edge bg-surface opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      class="block border-l-2 border-transparent px-4 py-2.5 text-[15px] text-ink-body transition-colors hover:border-brand hover:bg-surface-alt hover:text-brand-deep"
                      aria-current={isCurrent(c.href) ? "page" : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
