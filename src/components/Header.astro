---
/**
 * Top bar + masthead, extracted from Oxygen template post 6 so it matches the
 * old site on every page. The nav is a real <nav> with a disclosure-style
 * mobile menu; the old site's version needed JavaScript to open at all, which
 * left it unusable when scripts failed.
 */
import site from "@/content/site.json";

const { topBar, logo, menu } = site;
const here = Astro.url.pathname;
const isCurrent = (href: string | null) => !!href && href !== "/" && here.startsWith(href);
---

<!-- Top bar. The old site stacks these into a column below 992px (120px tall)
     and lays them out in a 34px row above it. -->
<div class="bg-surface-dark text-surface">
  <div class="container-ox flex flex-col items-center gap-x-6 pb-[5px] text-[18px] lg:h-[34px] lg:flex-row lg:justify-start lg:pb-0">
    {topBar.links.map((l) => (
      <a href={l.href} class="text-surface hover:text-surface-edge">{l.label}</a>
    ))}
    {/* The flag sits on its own 29px row on mobile, inline with the phone above 992px. */}
    {topBar.flag && <img src={topBar.flag.src} alt={topBar.flag.alt} width="24" height="16" class="h-[29px] w-auto object-contain lg:h-4" />}
    <a href={topBar.phone.href} class="text-surface hover:text-surface-edge">{topBar.phone.label}</a>
  </div>
</div>

<!-- Masthead: 80px tall, painted with the old site's white-to-grey gradient. -->
<header class="bg-linear-to-b from-surface to-[#89898e]">
  <div class="container-ox flex h-[110px] items-center justify-between gap-4 xl:h-[80px]">
    {logo && (
      <a href={logo.href} class="shrink-0">
        <img src={logo.src} alt={logo.alt} class="h-[90px] w-[90px] object-contain xl:h-[80px] xl:w-[80px]" width="90" height="90" />
      </a>
    )}

    <nav aria-label="Principal" class="ml-auto">
      <!-- Mobile: a native disclosure, so the menu opens without JavaScript. -->
      <details class="lg:hidden">
        <summary class="cursor-pointer list-none px-3 py-2 text-brand" aria-label="Abrir menú">
          <span class="block h-0.5 w-6 bg-brand"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-brand"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-brand"></span>
        </summary>
        <ul class="absolute left-0 z-20 w-full bg-surface px-5 pb-4 shadow-lg">
          {menu.map((item) => (
            <li class="border-b border-surface-edge py-2">
              <a href={item.href} class="font-medium" aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
              {item.children.length > 0 && (
                <ul class="mt-1 pl-4">
                  {item.children.map((c) => (
                    <li class="py-1">
                      <a href={c.href} class="text-ink" aria-current={isCurrent(c.href) ? "page" : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </details>

      <!-- Desktop: hover/focus dropdowns, CSS only. -->
      <ul class="hidden lg:flex lg:items-center lg:gap-6">
        {menu.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class="inline-block py-2 text-[16px] font-medium text-ink hover:text-brand"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
            {item.children.length > 0 && (
              <ul class="invisible absolute left-0 top-full z-20 min-w-64 bg-surface opacity-0 shadow-lg transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      class="block px-4 py-2 text-[15px] text-ink hover:bg-surface-alt hover:text-brand"
                      aria-current={isCurrent(c.href) ? "page" : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
