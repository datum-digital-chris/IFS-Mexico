---
/**
 * Contact flyout.
 *
 * The panel every Contáctenos in the masthead opens, carried over from the US
 * site (~/GitHub/IFS-Coatings, src/components/layout/ContactFlyout.astro): one
 * row per way of reaching IFS, so a visitor who only wants the phone number
 * never has to load a page to find it.
 *
 * Copy is authored in src/content/contact.json — it is not migrated content.
 * Every trigger is a real link to /contactenos/, upgraded to open the panel
 * only once this script runs, so the contact page stays reachable with
 * JavaScript unavailable.
 */
import contact from "@/content/contact.json";

/* Drawn here rather than loaded, because four line icons are smaller than a
   request. A whitelist, so a name in content can only ever select one of
   these - never reach through the object (C-DISPATCH-SAFE). */
const ICONS: Record<string, string> = {
  form: `<rect x="5" y="3" width="14" height="18" rx="1" /><path d="M9 8h6M9 12h6M9 16h4" />`,
  quote: `<path d="M11.6 3H4.5A1.5 1.5 0 0 0 3 4.5v7.1a1.5 1.5 0 0 0 .44 1.06l7.9 7.9a1.5 1.5 0 0 0 2.12 0l7.1-7.1a1.5 1.5 0 0 0 0-2.12l-7.9-7.9A1.5 1.5 0 0 0 11.6 3Z" /><path d="M7.5 7.5h.01" />`,
  phone: `<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2" />`,
  mail: `<rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 7 9 6 9-6" />`,
};

const items = contact.items.filter((item) =>
  Object.prototype.hasOwnProperty.call(ICONS, item.icon),
);
---

<div
  id="contact-flyout"
  class="contact-flyout"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label={contact.title}
>
  <div class="contact-flyout__backdrop" data-flyout-dismiss aria-hidden="true"></div>

  <div class="contact-flyout__panel" id="contact-flyout-panel">
    <div class="contact-flyout__header">
      <span class="contact-flyout__title">{contact.title}</span>
      <button type="button" class="contact-flyout__close" data-flyout-dismiss aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M4 4l10 10M14 4L4 14"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav class="contact-flyout__body" aria-label={contact.title}>
      {
        items.map((item) => (
          <a href={item.href} class="contact-flyout__item">
            <span class="contact-flyout__icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONS[item.icon]}
              />
            </span>
            <span>
              <span class="contact-flyout__label">{item.label}</span>
              <span class="contact-flyout__sub">{item.sub}</span>
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const flyout = document.getElementById("contact-flyout");
  const panel = document.getElementById("contact-flyout-panel");

  if (flyout && panel) {
    let lastTrigger: HTMLElement | null = null;

    const focusables = () =>
      Array.from(panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));

    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        close();
        return;
      }
      if (event.key !== "Tab") return;
      // A modal keeps the tab ring inside itself.
      const stops = focusables();
      if (!stops.length) return;
      const first = stops[0]!;
      const last = stops[stops.length - 1]!;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    function open(trigger: HTMLElement) {
      lastTrigger = trigger;
      flyout!.classList.add("contact-flyout--open");
      flyout!.setAttribute("aria-hidden", "false");
      flyout!.inert = false;
      focusables()[0]?.focus();
      document.addEventListener("keydown", onKey);
    }

    function close() {
      flyout!.classList.remove("contact-flyout--open");
      flyout!.setAttribute("aria-hidden", "true");
      flyout!.inert = true;
      document.removeEventListener("keydown", onKey);
      lastTrigger?.focus();
      lastTrigger = null;
    }

    flyout.inert = true;

    for (const trigger of document.querySelectorAll<HTMLElement>("[data-contact-trigger]")) {
      trigger.addEventListener("click", (event) => {
        // The trigger is a link to the contact page until this runs.
        event.preventDefault();
        open(trigger);
      });
    }

    for (const dismiss of flyout.querySelectorAll<HTMLElement>("[data-flyout-dismiss]")) {
      dismiss.addEventListener("click", close);
    }

    // A phone or mail row leaves the page, so the panel should not be sitting
    // open behind it when the visitor comes back.
    for (const link of panel.querySelectorAll("a[href]")) {
      link.addEventListener("click", close);
    }
  }
</script>
