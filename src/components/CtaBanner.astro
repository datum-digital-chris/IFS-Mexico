---
/**
 * Closing call to action.
 *
 * The house style (.claude/rules/00-core/CLAUDE.core.md) is that every page ends
 * with a CTA banner; the old Mercados pages simply stopped after the last
 * paragraph. Copy is authored in src/content/market-cta.json — it is not
 * migrated content.
 *
 * Brand red rather than the footer's charcoal: it has to separate the light
 * page above from the dark footer below, and merging into the footer would make
 * it disappear.
 */
import cta from "@/content/market-cta.json";

interface Props {
  market: string;
}

const { market } = Astro.props;
const copy = cta.markets[market as keyof typeof cta.markets];
---

{
  copy && (
    <section class="bg-brand-deep text-surface">
      <div class="container-ox flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between md:py-14">
        <div class="max-w-2xl">
          <h2 class="text-surface text-[clamp(1.5rem,1.2rem+1vw,2rem)]">{copy.heading}</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-surface/85">{copy.description}</p>
        </div>
        <a
          href={cta.href}
          class="inline-flex shrink-0 items-center gap-2 self-start border border-surface bg-surface px-6 py-3 font-heading font-semibold text-brand-deep transition-colors hover:bg-transparent hover:text-surface md:self-auto"
        >
          {cta.label}
          <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  )
}
