---
/**
 * Closing call to action.
 *
 * The house style (.claude/rules/00-core/CLAUDE.core.md) is that every page ends
 * with a CTA banner; the old Mercados pages simply stopped after the last
 * paragraph. Copy is authored in src/content/market-cta.json — it is not
 * migrated content.
 *
 * Deliberately quiet: a white band with a brand rule, not a full colour block.
 * It closes the page without competing with the hero, and still separates the
 * tinted page above from the dark footer below.
 */
import cta from "@/content/market-cta.json";

interface Props {
  market: string;
}

const { market } = Astro.props;
const copy = cta.markets[market as keyof typeof cta.markets];
---

{
  copy && (
    <section class="border-t-2 border-brand bg-surface">
      <div class="container-ox flex flex-col gap-5 py-8 md:flex-row md:items-center md:justify-between md:gap-10 md:py-9">
        <div class="max-w-xl">
          <h2 class="text-[1.125rem] leading-snug md:text-[1.25rem]">{copy.heading}</h2>
          <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-body">{copy.description}</p>
        </div>
        <a
          href={cta.href}
          class="ox-btn inline-flex shrink-0 items-center gap-2 self-start px-5 py-2.5 text-[0.9375rem] md:self-auto"
        >
          {cta.label}
          <svg class="h-3 w-3" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  )
}
