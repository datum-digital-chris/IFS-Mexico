---
/**
 * Closing call to action.
 *
 * The house style (.claude/rules/00-core/CLAUDE.core.md) is that every page ends
 * with a CTA banner; the old pages simply stopped after the last paragraph.
 * Copy is authored in src/content/cta.json — it is not migrated content. The
 * seven markets name their market; every other page takes the default.
 *
 * The brand fill with a white button, terminal on the page: the US site's CTA
 * block, which is the one place the decorative accent covers a whole section
 * and the reason it is not spent anywhere else. The fill is the metallic sweep
 * (`.ox-brand-fill`), never a flat hex.
 *
 * Contáctenos is the one page the band would send back to itself, so it closes
 * on the form instead.
 */
import cta from "@/content/cta.json";

interface Props {
  /** The page's key, for a market that has copy of its own. */
  page: string;
}

const { page } = Astro.props;
const copy = cta.pages[page as keyof typeof cta.pages] ?? cta.default;
const isTarget = Astro.url.pathname === cta.href;
const isSecondaryTarget = Astro.url.pathname === cta.secondary.href;
---

{
  copy && !isTarget && (
    <section class="ox-brand-fill">
      <div class="container-ox flex flex-col gap-10 py-20 sm:flex-row sm:items-center sm:justify-between sm:py-24">
        <div class="max-w-measure">
          <h2 class="display text-surface text-3xl sm:text-4xl">{copy.heading}</h2>
          <p class="text-surface/75 mt-3 text-lg">{copy.description}</p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 self-start sm:flex-row sm:self-auto">
          <a href={cta.href} class="ox-btn ox-btn--white ox-btn--lg">
            {cta.label}
          </a>
          {!isSecondaryTarget && (
            <a href={cta.secondary.href} class="ox-btn ox-btn--outline ox-btn--lg">
              {cta.secondary.label}
            </a>
          )}
        </div>
      </div>
    </section>
  )
}
