---
/**
 * Closing call to action.
 *
 * The house style (.claude/rules/00-core/CLAUDE.core.md) is that every page ends
 * with a CTA banner; the old Mercados pages simply stopped after the last
 * paragraph. Copy is authored in src/content/market-cta.json — it is not
 * migrated content.
 *
 * The brand fill with a white button, terminal on the page: the US site's CTA
 * block, which is the one place the decorative accent covers a whole section
 * and the reason it is not spent anywhere else. The fill is the metallic sweep
 * (`.ox-brand-fill`), never a flat hex.
 */
import cta from "@/content/market-cta.json";

interface Props {
  market: string;
}

const { market } = Astro.props;
const copy = cta.markets[market as keyof typeof cta.markets];
---

{
  copy && (
    <section class="ox-brand-fill">
      <div class="container-ox flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between md:gap-12 md:py-16">
        <div class="max-w-2xl">
          <h2 class="display text-surface text-[clamp(1.625rem,1.35rem+1.1vw,2.25rem)]">
            {copy.heading}
          </h2>
          <p class="text-surface/85 mt-4 text-[1.0625rem] leading-relaxed">{copy.description}</p>
        </div>
        <a
          href={cta.href}
          class="ox-btn ox-btn--white inline-flex shrink-0 items-center gap-2.5 self-start md:self-auto"
        >
          {cta.label}
          <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M1 7h11M8 3l4 4-4 4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>
  )
}
